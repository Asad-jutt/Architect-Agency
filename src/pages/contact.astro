---
import Layout from '../layouts/Layout.astro';
import { ContactPage } from '../components/pages/ContactPage';
import { SITE_URL } from '../data/site';

const title = 'Contact & Start a Project | ARCHITECT.EXE Webflow & React Development';
const description =
  'Brief ARCHITECT.EXE directly. High-performance Webflow, React and Three.js builds with liquid animations — expect a response from a senior operative within 24 hours.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE_URL}/contact` },
  ],
};

const contactPageLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact ARCHITECT.EXE',
  url: `${SITE_URL}/contact`,
  description,
  mainEntity: {
    '@type': 'Organization',
    name: 'ARCHITECT.EXE',
    email: 'mailto:hello@architect.exe',
  },
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd, contactPageLd]}>
  <ContactPage client:load />
</Layout>
