---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { HeroSection } from '../components/HeroSection';
import { LogoStripSection } from '../components/LogoStripSection';
import { ProjectCardsSection } from '../components/ProjectCardsSection';
import { ProcessSection } from '../components/ProcessSection';
import { TechStackSection } from '../components/TechStackSection';
import { TestimonialsSection } from '../components/TestimonialsSection';
import { TeamSection } from '../components/TeamSection';
import { AboutSection } from '../components/AboutSection';
import { FaqSection } from '../components/ui/habit-faq-scroller';
import { Footer } from '../components/ui/modem-animated-footer';
import MotionProvider from '../components/MotionProvider';
import { SITE_URL } from '../data/site';
import { DEFAULT_FAQ_DATA } from '../components/ui/habit-faq-scroller';

const title = 'ARCHITECT.EXE | High-Performance Webflow & React Development Agency';
const description =
  'ARCHITECT.EXE designs and builds brutalist, high-performance websites with Webflow, React, Three.js and WebGL — liquid animations, 90+ Lighthouse scores, and unapologetic visual identity.';

const faqs = DEFAULT_FAQ_DATA.rows.flatMap((row) => row.faqItems);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
  ],
};

const jsonLd = [faqLd, breadcrumbLd];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <MotionProvider client:idle />

  <div class="min-h-screen w-full bg-black text-white relative font-geist selection:bg-[#C6FF00] selection:text-black flex flex-col justify-between overflow-x-clip">
    <div
      class="fixed inset-0 pointer-events-none opacity-[0.03] z-0"
      style="background-image: radial-gradient(#C6FF00 1px, transparent 1px), linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 40px 40px;"
    />

    <div class="relative z-10 flex-1 flex flex-col justify-between">
      <Navbar client:idle pathname="/" />

      <main class="flex-1 flex flex-col">
        <HeroSection client:idle />
        <LogoStripSection client:visible />
        <ProjectCardsSection client:visible />
        <ProcessSection client:visible />
        <TechStackSection client:visible />
        <TestimonialsSection client:visible />
        <AboutSection client:visible />
        <TeamSection client:visible />
        <FaqSection client:visible />
      </main>

      <Footer client:visible />
    </div>
  </div>

  <!--
    Hero silk background runs in its own tiny script (not tied to React hydration)
    so the original canvas animation starts the moment the page JS executes.
  -->
  <script>
    import { startSilkAnimation } from '../utils/silkCanvas';
    const heroSilkCanvas = document.getElementById('hero-silk-canvas');
    if (heroSilkCanvas instanceof HTMLCanvasElement) {
      startSilkAnimation(heroSilkCanvas);
    }
  </script>

  <!--
    Hero entrance animation runs in its own early script (not tied to React
    hydration) so it starts as soon as the DOM is parsed, right at page load.
    Skipped entirely when the user prefers reduced motion.
  -->
  <script>
    import { gsap } from 'gsap';

    const prefersReducedMotion =
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isCoarsePointer =
      typeof window !== 'undefined' &&
      window.matchMedia('(pointer: coarse)').matches;
    if (prefersReducedMotion) {
      document
        .querySelectorAll('#sticker-release, #sticker-dna, #heading-architect, #btn-initialize-system, #status-container-click, #hero-bio, #latency-container')
        .forEach((el) => el.removeAttribute('style'));
    } else {
    const heroTl = gsap.timeline({
      defaults: { ease: 'power3.out', duration: 0.6 },
      onComplete: () => {
        gsap.set(
          ['#btn-initialize-system', '#heading-architect', '#sticker-release', '#sticker-dna'],
          { clearProps: 'opacity' }
        );
      },
    });

    heroTl
      .from('header', { y: -30, opacity: 0, duration: 0.5, clearProps: 'transform,translate,rotate,scale,opacity' });
    // The H1 is the LCP element — animating it with opacity:0 delays the
    // first meaningful paint. On touch devices leave it fully visible so
    // it renders immediately (the surrounding elements still animate).
    if (!isCoarsePointer) {
      heroTl.from('#heading-architect', { y: 24, opacity: 0, scale: 0.96, duration: 0.7, ease: 'power3.out' }, '-=0.2');
    }
    heroTl
      .from('#sticker-release', { scale: 0, rotation: -12, opacity: 0, ease: 'back.out(1.5)' }, '-=0.3')
      .from('#sticker-dna', { scale: 0, rotation: 12, opacity: 0, ease: 'back.out(1.5)' }, '-=0.3')
      .from('#btn-initialize-system', { y: 20, opacity: 0 }, '-=0.3')
      .from('#status-container-click', { x: 20, opacity: 0 }, '-=0.4')
      .from('#hero-bio', { y: 20, opacity: 0, duration: 0.6 }, '-=0.5')
      .from('#latency-container', { x: 20, opacity: 0, duration: 0.6 }, '-=0.7');
    }
  </script>
</Layout>
