---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { WorksPage } from '../components/pages/WorksPage';
import { PROJECTS_LIST } from '../data/projectsData';
import { SITE_URL } from '../data/site';

const title = 'Selected Works & Case Studies | ARCHITECT.EXE Webflow & React Projects';
const description =
  'Browse ARCHITECT.EXE selected works: Webflow builds, React apps, Three.js WebGL experiments and commercial case studies with 90+ Lighthouse scores.';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ARCHITECT.EXE Selected Works',
  numberOfItems: PROJECTS_LIST.length,
  itemListElement: PROJECTS_LIST.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: `${SITE_URL}/projects/${p.slug || p.id}`,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Selected Works', item: `${SITE_URL}/works` },
  ],
};
---

<Layout title={title} description={description} jsonLd={[itemListLd, breadcrumbLd]}>
  <Fragment slot="head">
    {
      PROJECTS_LIST.map((p, i) => (
        <link rel="preload" as="image" href={p.imageUrl} fetchpriority={i === 0 ? 'high' : 'low'} />
      ))
    }
  </Fragment>
  <div
    class="relative w-full bg-black text-white overflow-hidden"
    style="height:100vh;height:100dvh;"
  >
    <!-- Full-viewport WebGL slider -->
    <div class="absolute inset-0 z-0">
      <WorksPage client:load />
    </div>

    <!-- Overlay navbar -->
    <div class="absolute inset-x-0 top-0 z-30">
      <Navbar client:load pathname="/works" />
    </div>
  </div>

  <!-- Accessible / SEO fallback list for the WebGL slider -->
  <section aria-label="Project directory" class="sr-only">
    <h1>Selected Works by ARCHITECT.EXE</h1>
    <ul>
      {PROJECTS_LIST.map((p) => (
        <li>
          <a href={`/projects/${p.slug || p.id}`}>{p.title} — {p.subtitle}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
